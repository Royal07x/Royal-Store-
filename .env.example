NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=

# Authentication
JWT_SECRET=

# Password reset
# RESET_URL should point to the public reset-password.html page.
RESET_URL=http://localhost:5500/reset-password.html
# console is development-only; production requires a real email adapter.
RESET_DELIVERY_MODE=console

# Payments (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloud AI (server-side only)
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL=

# Frontend/API access
CORS_ORIGIN=

# Store contact
WHATSAPP_NUMBER=

# Optional operational monitoring
# ISO-8601 timestamp of the latest verified successful production backup.
BACKUP_LAST_SUCCESS_AT=
